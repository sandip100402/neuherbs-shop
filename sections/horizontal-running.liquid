{% comment %}
  Horizontal Running Text Section
  User can edit texts, links, colors, and speed from theme editor.
{% endcomment %}

<div id="shopify-section-{{ section.id }}" class="shopify-section laber_section type_text_horizontal_running">
  <section id="laber_{{ section.id }}">   
    <div class="full-width">
      <div class="text-horizontal-running">
        <p style="--color-text:{{ section.settings.text_color }};--alo-healing-speed:{{ section.settings.speed }}s;">
          {% for block in section.blocks %}
            <a href="{{ block.settings.link }}" title="{{ block.settings.text }}" target="_blank" aria-label="link">
              <span class="flex">{{ block.settings.text }}</span>
            </a>
          {% endfor %}
        </p>
      </div>
    </div>
  </section>

  <style>
    #laber_{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-right: {{ section.settings.padding_right }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      padding-left: {{ section.settings.padding_left }}px;
      background-color: {{ section.settings.bg_color }};
    }

    @media only screen and (max-width: 1024px) {
      #laber_{{ section.id }} {
        padding-top: 0px;
        padding-right: 1px;
        padding-bottom: 0px;
        padding-left: 1px;
      }
    }
  </style>
</div>


{% schema %}
{
  "name": "Horizontal Running Text",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#167a62"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll Speed (seconds)",
      "default": 30,
      "min": 5,
      "max": 60,
      "step": 1
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1
    },
    {
    "type": "range",
    "id": "padding_right",
    "label": "Padding Right",
    "default": 40,
    "min": 0,
    "max": 100,
    "step": 1
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Padding Left",
      "default": 40,
      "min": 0,
      "max": 100,
      "step": 1
    }
  ],
  "blocks": [
    {
      "type": "text_item",
      "name": "Text Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "No Additives"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Horizontal Running Text",
      "category": "Text",
      "blocks": [
        { "type": "text_item", "settings": { "text": "No Additives" } },
        { "type": "text_item", "settings": { "text": "No Artificial Preservatives" } },
        { "type": "text_item", "settings": { "text": "Heavy-Metal Tested" } },
        { "type": "text_item", "settings": { "text": "No Artificial Colour or Flavour" } },
        { "type": "text_item", "settings": { "text": "Organic" } },
        { "type": "text_item", "settings": { "text": "Non-GMO" } },
        { "type": "text_item", "settings": { "text": "Naturally Gluten-Free" } }
      ]
    }
  ]
}
{% endschema %}
