{% liquid
  assign sid = section.id
%}

<section id="laber_se_{{ sid }}" class="text-column-with-image">
  <div class="{% if section.settings.layout == 'full-width' %}{{section.settings.layout}}{% else %}container{% endif %}">
    
    {% if section.settings.title != blank %}
      <div class="wrap_title medium">
        <div class="h2 section-title alo-text-transform" style="--alo-text-transform:capitalize">
          {{ section.settings.title }}
        </div>
      </div>
    {% endif %}
    
    {% if section.blocks.size > 0 %}
      <div class="content_section slick-carousel">
        <div class="grid-slider js_carousel laber-slick-carousel grid-slider-{{ sid }}"
             data-wrapper="#shopify-section-{{ sid }}"
             data-adaptive-height="false"
             data-autoplay="{% if section.settings.autoplay %}true{% else %}false{% endif %}"
             data-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
             data-arrows="{% if section.settings.arrows %}true{% else %}false{% endif %}"
             data-center-mode="false"
             data-dots="{% if section.settings.dots %}true{% else %}false{% endif %}"
             data-fade="false"
             data-infinite="{% if section.settings.infinite %}true{% else %}false{% endif %}"
             data-padding="15"
             data-rows="1"
             data-slides-to-show="{{ section.settings.slides_to_show }}"
             data-slides-to-scroll="1"
             data-speed="{{ section.settings.speed }}"
             data-vertical="false"
             data-vertical-swiping="false"
             data-responsive="[{&quot;breakpoint&quot;:1920,&quot;settings&quot;:{&quot;slidesToShow&quot;:{{ section.settings.slides_to_show }}}},{&quot;breakpoint&quot;:1200,&quot;settings&quot;:{&quot;slidesToShow&quot;:{{ section.settings.slides_to_show_tablet }}}},{&quot;breakpoint&quot;:768,&quot;settings&quot;:{&quot;slidesToShow&quot;:{{ section.settings.slides_to_show_mobile }}}}]"
             data-append-arrows=".arrows_{{ sid }}"
             data-append-dots=".dots_{{ sid }}">
          
          {% for block in section.blocks %}
            <div class="alo-item">
              <div class="text_column_with_img">
                {% if block.settings.image != blank %}
                  <div class="images2">
                    <div class="alo-image overflow-hidden alo-border-radius ratio w-full h-full" style="--ratio-percent: 100%;">
                      <img src="{{ block.settings.image | image_url }}" alt="{{ block.settings.heading | escape }}" loading="lazy">
                    </div>
                  </div>
                {% endif %}
                
                <div class="text-content">
                  {% if block.settings.heading != blank %}
                    <h3 class="h3">{{ block.settings.heading }}</h3>
                  {% endif %}
                  
                  {% if block.settings.text != blank %}
                    <div class="rte-setting">{{ block.settings.text }}</div>
                  {% endif %}
                  
                  {% if block.settings.button_label != blank and block.settings.button_link != blank %}
                    <div class="btn">
                      <a href="{{ block.settings.button_link }}" target="_blank">{{ block.settings.button_label }} <i class="icon-chevrons-right"></i></a>
                    </div>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
        
        {% if section.settings.dots %}
          <div class="laber_append_dots dots_{{ sid }}"></div>
        {% endif %}
        {% if section.settings.arrows %}
          <div class="arrows_{{ sid }} laber_arrow"></div>
        {% endif %}
      </div>
    {% endif %}
    
  </div>
</section>

<style>
  #laber_se_{{ sid }} {
    padding: {{ section.settings.padding }};
    background-color: {{ section.settings.bg_color }};
  }
  @media only screen and (max-width: 1024px) {
    #laber_se_{{ sid }} {
      padding: {{ section.settings.padding_mb }};
    }
  }
</style>

{% schema %}
{
  "name": "Text Column Slider",
  "class": "cms_section type_gallery laber_text-column-with-image",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Super Safe Standards"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "container", "label": "Container" },
        { "value": "full-width", "label": "Full Width" }
      ],
      "default": "container"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f8f8f8"
    },
    {
      "type": "text",
      "id": "padding",
      "label": "Padding (Desktop)",
      "default": "20px 0 20px 0"
    },
    {
      "type": "text",
      "id": "padding_mb",
      "label": "Padding (Mobile)",
      "default": "10px 0 10px 0"
    },
    {
      "type": "header",
      "content": "Slider Settings"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Autoplay Speed",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "arrows",
      "label": "Show Arrows",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "dots",
      "label": "Show Dots",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "infinite",
      "label": "Infinite Loop",
      "default": false
    },
    {
      "type": "range",
      "id": "speed",
      "min": 300,
      "max": 1000,
      "step": 100,
      "unit": "ms",
      "label": "Transition Speed",
      "default": 300
    },
    {
      "type": "range",
      "id": "slides_to_show",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Slides to Show (Desktop)",
      "default": 4
    },
    {
      "type": "range",
      "id": "slides_to_show_tablet",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Slides to Show (Tablet)",
      "default": 3
    },
    {
      "type": "range",
      "id": "slides_to_show_mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Slides to Show (Mobile)",
      "default": 1
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "India Organic Certified"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Description",
          "default": "<p>Short description here...</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Text Column Slider",
      "category": "Image"
    }
  ]
}
{% endschema %}
