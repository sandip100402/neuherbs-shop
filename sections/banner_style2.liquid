{% liquid
  assign sid = section.id 
  assign layout = section.settings.layout
  assign bok_distance = section.settings.bok_distance
  assign se_blocks = section.blocks
  assign se_size = se_blocks.size

  
  
%}
   
{%- for i in (1..1) -%}
{%- if section.settings.hidden %}{% break %}{% endif -%}
<section style="padding:{{section.settings.mg_top}}px {{section.settings.mg_right}}px {{section.settings.mg_bottom}}px {{section.settings.mg_left}}px; background-color:{{section.settings.cl_bg}}">       
  <div class=" container {%if layout == 'full-width' %}{{layout}}{%endif%} {{bok_distance}}">
    {% if section.settings.title != blank or section.settings.sub_title!= blank %}
    <div class="wrap_title col-lg-auto col-12">
      <div class="wrap_inner_title">
        {% if section.settings.title != blank %}
        <h3 class="section-title">{{section.settings.title}}</h3>  
        {% endif %}
        {% if section.settings.sub_title!= blank %}
        <span class="section-subtitle">{{section.settings.sub_title}}</span>
        {% endif %}
      </div>
    </div> 
    {% endif %} 
    <div class="row laber-row">
      {%- case se_size -%}
			{%- when 1 -%}
      			{%- render 'bammer-item',block:se_blocks[0], cimg:'https://placehold.jp/100/f76b6a/fff/1920x530.png?text=1920x530',ratio_demo:'27.604' ,ccol:'laber-col col-sm-12',for_i:1 -%}
			{%- when 2 -%}
      			{%- render 'bammer-item',block:se_blocks[0], cimg:'https://placehold.jp/100/f76b6a/fff/692x400.png?text=692x400',ratio_demo:'57.803' ,ccol:'laber-col col-md-6 col-sm-12',for_i:1 -%}
      			{%- render 'bammer-item',block:se_blocks[1,  cimg:'https://placehold.jp/100/f76b6a/fff/692x400.png?text=692x400',ratio_demo:'57.803' ,ccol:'laber-col col-md-6 col-sm-12',for_i:1 -%}	
      		{%- when 3 -%}
      			{%- render 'bammer-item',block:se_blocks[0], cimg:'https://placehold.jp/50/f76b6a/fff/620x600.png?text=620x600',ratio_demo:'96.774' ,ccol:'laber-col col-lg-4 col-md-12 col-sm-12',for_i:1 -%}
      			{%- render 'bammer-item',block:se_blocks[1], cimg:'https://placehold.jp/50/f76b6a/fff/620x600.png?text=620x600',ratio_demo:'96.774' ,ccol:'laber-col col-lg-4 col-md-12 col-sm-12',for_i:1 -%}
     			{%- render 'bammer-item',block:se_blocks[2], cimg:'https://placehold.jp/50/f76b6a/fff/620x600.png?text=620x600',ratio_demo:'96.774' ,ccol:'laber-col col-lg-4 col-md-12 col-sm-12',for_i:1 -%}
      		{%- when 4 -%}
      			<div class="laber-col col-md-6 col-sm-12">
                  <div class="row laber-row">
      				{%- render 'bammer-item',block:se_blocks[0], cimg:'https://placehold.jp/50/f76b6a/fff/575x500.png?text=575x500',ratio_demo:'86.956' ,ccol:'laber-col col-sm-12',for_i:1 -%}
                  </div>
      			</div>
      			<div class="laber-col col-md-6 col-sm-12">
                  <div class="row laber-row">
                    {%- render 'bammer-item',block:se_blocks[1], cimg:'https://placehold.jp/50/f76b6a/fff/575x240.png?text=575x240',ratio_demo:'41.739' ,ccol:'laber-col col-sm-12',for_i:1 -%}
     			    {%- render 'bammer-item',block:se_blocks[2], cimg:'https://placehold.jp/50/f76b6a/fff/277x240.png?text=277x240',ratio_demo:'86.642' ,ccol:'laber-col col-md-6 col-sm-6',for_i:1 -%}
      			    {%- render 'bammer-item',block:se_blocks[3], cimg:'https://placehold.jp/50/f76b6a/fff/277x240.png?text=277x240',ratio_demo:'86.642' ,ccol:'laber-col col-md-6 col-sm-6',for_i:1 -%}
                  </div>
      			</div>
      		{%- when 5 -%}
      			<div class="laber-col col-md-8 col-sm-12">
                  <div class="row laber-row">
                    {%- render 'bammer-item',block:se_blocks[0], cimg:'https://placehold.jp/100/f76b6a/fff/1880x820.png?text=930x500',ratio_demo:'53.763' ,ccol:'laber-col col-sm-12',for_i:1 -%}
                    {%- render 'bammer-item',block:se_blocks[1], cimg:'https://placehold.jp/100/f76b6a/fff/1880x820.png?text=450x185',ratio_demo:'41.111' ,ccol:'laber-col col-md-6 col-sm-12',for_i:1 -%}
                    {%- render 'bammer-item',block:se_blocks[2], cimg:'https://placehold.jp/100/f76b6a/fff/1880x820.png?text=450x185',ratio_demo:'41.111' ,ccol:'laber-col col-md-6 col-sm-12',for_i:1 -%}
                  </div>
                </div>
      			<div class="laber-col col-md-4 col-sm-12">
                  <div class="row laber-row">
                    {%- render 'bammer-item',block:se_blocks[3], cimg:'https://placehold.jp/100/f76b6a/fff/1880x820.png?text=450x185',ratio_demo:'41.111' ,ccol:'laber-col col-sm-12',for_i:1 -%}
                    {%- render 'bammer-item',block:se_blocks[4], cimg:'https://placehold.jp/100/f76b6a/fff/1880x820.png?text=450x500',ratio_demo:'111.111' ,ccol:'laber-col col-sm-12',for_i:1 -%}
                  </div>
      			</div>
            {%- when 6-%}
      			{%- render 'bammer-item',block:se_blocks[0], cimg:'https://placehold.jp/100/f76b6a/fff/1880x820.png?text=1880x820',ratio_demo:'43.617' ,ccol:'laber-col col-md-4 col-sm-12',for_i:1 -%}
      			{%- render 'bammer-item',block:se_blocks[1], cimg:'https://placehold.jp/100/f76b6a/fff/1880x820.png?text=1880x820',ratio_demo:'43.617' ,ccol:'laber-col col-md-4 col-sm-12',for_i:1 -%}
     			{%- render 'bammer-item',block:se_blocks[2], cimg:'https://placehold.jp/100/f76b6a/fff/1880x820.png?text=1880x820',ratio_demo:'43.617' ,ccol:'laber-col col-md-4 col-sm-12',for_i:1 -%}
      			{%- render 'bammer-item',block:se_blocks[3], cimg:'https://placehold.jp/100/f76b6a/fff/1880x820.png?text=1880x820',ratio_demo:'43.617' ,ccol:'laber-col col-md-4 col-sm-12',for_i:1 -%}
     			{%- render 'bammer-item',block:se_blocks[4], cimg:'https://placehold.jp/100/f76b6a/fff/1880x820.png?text=1880x820',ratio_demo:'43.617' ,ccol:'laber-col col-md-4 col-sm-12',for_i:1 -%}
     			{%- render 'bammer-item',block:se_blocks[5], cimg:'https://placehold.jp/100/f76b6a/fff/1880x820.png?text=1880x820',ratio_demo:'43.617' ,ccol:'laber-col col-md-4 col-sm-12',for_i:1 -%}
     {%- endcase -%}
      
    </div>    
  </div>
</section>
{%- endfor -%}


{%- schema -%}
  {
    "name": "Banner images (style 2)",
    "class": "laber_section cms_section type_banner_2 banner_style2 zoom_img",	
    "max_blocks": 6,
    "settings": [
      {
      "type": "checkbox",
      "id": "hidden",
      "label": "Hidden Section?",
      "default": false
      },
	  {
        "type": "header",
        "content": "== General Settings"
      },
      {
        "type": "text",
        "id": "title",
        "label": "Heading of section",
		"default":"What ingredients?"
      },     
      {
        "type": "header",
        "content": "== Design Options"
      }, 
	  {
        "type": "select",
        "id": "bok_distance",
        "default": "default",
        "options": [
         {
            "value": "distance-0",
            "label": "0"
         },
		 {
            "value": "distance-5",
            "label": "5px"
          },
         {
            "value": "distance-10",
            "label": "10px"
          },
         {
            "value": "default",
            "label": "default"
          }
        ],
        "label": "Distance of blocks"
      },
      {
        "type": "select",
        "id": "layout",
        "default": "container",
        "options": [
         {
            "value": "container",
            "label": "Container"
         },
         {
            "value": "full-width",
            "label": "Full Width"
          }
        ],
        "label": "Layout"
      },    
      {
        "type": "color",
        "id": "cl_bg",
        "label": "Background color",
        "default": "#fff"
      },
      {
        "type": "range",
        "id": "mg_top",
        "label": "Margin top",
        "default": 130,
        "min": 0,
        "max": 200,
        "step": 5,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "mg_right",
        "label": "Margin right",
        "default": 0,
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "mg_bottom",
        "label": "Margin bottom",
        "default": 0,
        "min": 0,
        "max": 200,
        "step": 5,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "mg_left",
        "label": "Margin left",
        "default": 0,
        "min": 0,
        "max": 200,
        "step": 5,
        "unit": "px"
      }
    ],
    "blocks": [
      {
        "type": "banner",
        "name": "Item",
        "settings": [          
          {
            "type": "header",
            "content": "== Image settings"
          },
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image",
            "info" :"Dimension: 150 x 150 (px)"
          },	
          {
            "type": "header",
            "content": "== Text settings"
          },
          {
            "type": "text",
            "id": "title",
            "label": "Title",
            "default": "New Arrivals"
          },
		  {
              "type": "text",
              "id": "b_title",
              "label": "Button label",
              "default": "Learn More"
            },
            {
              "type": "url",
              "id": "btn_link",
              "label": "Button link",
			  "info": "Note: if you want to display this button then you need to fill button link"
            }, 
           {
              "type": "select",
              "id": "open_link",
              "options": [
                {
                  "value": "_self",
                  "label": "Current window (_self)"
                },
               {
                  "value": "_blank",
                  "label": "New window (_blank)"
                }
              ],
              "label": "Open link in",
              "default": "_blank"
            },
        {
        "type": "header",
        "content": "== Settings Position"
        },
		{
        "type": "select",
        "id": "h_position",
        "label": "Horizontal Position",
        "default": "left",
        "options": [
            {
            "value": "left",
            "label": "Left"
            },
            {
            "value": "center",
            "label": "Center"
            },
            {
            "value": "right",
            "label": "Right"
            }
          ]
        },
        {
        "type": "select",
        "id": "v_position",
        "label": "Vertical Position",
        "default": "top",
        "options": [
            {
            "value": "top",
            "label": "Top"
            },
            {
            "value": "middle",
            "label": "Middle"
            },
            {
            "value": "bottom",
            "label": "Bottom"
            }
          ]
        },
		{
            "type": "select",
            "id": "txt_align",
            "label": "Text Align",
            "default": "left",
            "options": [
              {
                "value": "left",
                "label": "Left"
              },
              {
                "value": "center",
                "label": "Center"
              },
              {
                "value": "right",
                "label": "Right"
              }
            ]
          },
          {
            "type": "range",
            "id": "mg_bottom",
            "label": "Margin bottom",
            "default": 0,
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "px"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Banner images (Style 2)",
        "category": "Images",
		"blocks": [{"type": "banner"},{"type": "banner"},{ "type": "banner"},{ "type": "banner"},{ "type": "banner"}]		
      }
    ]
  }
{% endschema %}
