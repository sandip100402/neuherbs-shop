{%- liquid
  assign sid = section.id
  assign section_blocks = section.blocks  
  assign layout = section.settings.layout
  assign arr_col = section_blocks | where: "type", "col"    
    assign col_pr =section.settings.col_pr |plus:0
    assign col_ipad_pro =section.settings.col_pr_tab_pro |plus:0
    assign col_ipad =section.settings.col_pr_tab |plus:0
    assign col_mobile =section.settings.col_pr_mob |plus:0
    assign col_mobile_vertical =section.settings.col_pr_mob_vertical |plus:0
    
    if col_pr == 5
    	assign col = 15
    else
    	assign col = 12 | divided_by: col_pr
    endif
    
  assign autoplay =  section.settings.autoplay
  assign arrows =  section.settings.arrows
  assign dots =  section.settings.dots
  assign infinite =  section.settings.infinite
  
  -%}
{%- for i in (1..1) -%}
<section id="laber_{{sid}}" class="laber_se_{{sid}}">
  <div class="container {%if layout == 'full-width' %}{{layout}}{%endif%}" >
    <div class="row">
      <div class="{{section.settings.tab-pos}} col-xs-12 col-sm-12 col-md-12 col-lg-5">
        <div class="content-tab"  style="
                                         {% if section.settings.color_bg != blank %}background-color:{{section.settings.color_bg}};{%endif%}
                                         {% if section.settings.bg != blank %}background-image: url('{{ section.settings.bg | img_url:"552x"}}');{%endif%}" >
          <div class="wrap_title ">

            {% if section.settings.sub_title!= blank %}
            <span class="section-subtitle">{{section.settings.sub_title}}</span>
            {% endif %}

            {% if section.settings.title != blank %}
            <h3 class="section-title">{{section.settings.title}}</h3>  
            {% endif %}

          </div>

          {%- if arr_col.size > 0 -%} 
          <div class="tabcontent">
            <div class="tab-products" data-sorting-collections-control="">
              <ul>
                {%- for block in arr_col -%}
                {%- if collections[block.settings.collection] != blank -%}
                <li>
                  <a href="{{ collections[block.settings.collection].url }}"{% if section.blocks.size > 1 %} class="{% if forloop.index == 1 %}active{% endif %}"{% endif %} data-collection="{{ collections[block.settings.collection].handle }}">
                    {% if block.settings.title != blank %}
                    {% assign somearray = block.settings.title | split: ' ' %} 
                    {% for item in somearray %}
                    <span>{{item}}</span>
                    {%endfor%}
                    {% else %}
                    {{ collections[block.settings.collection].title }}
                    {% endif %}
                  </a>
                </li>
                {%- else -%}
                <li>
                  <a href="#"{% if section.blocks.size > 1 %} class="{% if forloop.index == 1 %}active{% endif %}{% endif %}">
                    {% if block.settings.title != blank %}
                    {% assign somearray = block.settings.title | split: ' ' %} 
                    {% for item in somearray %}
                    <span>{{item}}</span>
                    {%endfor%}
                    {% endif %}
                  </a>
                </li>
                {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>
          </div>
          {% endif %}

          {%if section.settings.show_view_all %}
          <div class="bn_button viewall">
            	{%- if  section.settings.title != blank -%}
                	<a  class="buttons" href="{{section.settings.btn_link}}" target="{{block.settings.open_link}}">
                      	{{section.settings.text_button}}
            		</a>
                {%- endif -%}
           </div>
          {%endif%}
        </div>
      </div>
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-7">
        <div class="products-arrivals">
          {%- if arr_col.size > 0 -%} 
          <div class="sorting-collections" data-sorting-collections-ajax>      
            <div class="ajax_load ">
              <div class="circle-loadding"><span></span></div>
            </div>
            <div data-js-collection-tab class="section-content js_container_cat" data-mobile="{{col_mobile}}" data-tablet="{{col_ipad}}"> 
              {% capture grid %}col-xs-12 col-sm-6 col-md-4 col-lg-{{ col }}{% endcapture %}
              {%- for block in arr_col limit: 1 -%}
                <div class="laber-slick-carousel carousel-pd-{{col}} sorting-collections__products pr_center row" data-sorting-collections-items 
                     data-limit="{{ section.settings.max_count }}" 
                     data-col="{{col}}" 
                     data-grid="{{ grid }}" 
                     data-slider="true" data-slick='{"slidesToShow": {{col_pr}}, "slidesToScroll":{{col_pr}}, "infinite": {{infinite}}, "lazyLoad": "ondemand", "autoplay": {{autoplay}}, "autoplaySpeed": 2000, "arrows": {{arrows}}, "dots":{{dots}}}'>                
				  	
                  {%- if block.settings.collection != blank -%}
                    {%- assign products = collections[block.settings.collection].products -%}
                    {%- capture url_cat -%}{%- if routes.root_url != '/' -%}{{routes.root_url}}{%- endif -%}{% if collection %}/collections/{{collection.handle}}{% endif %}{%- endcapture -%}
                    {%- for product in products limit: section.settings.max_count -%}
                    {% assign pr_hd = product.handle %}
                    <div data-lazy-product-load  class="productLazyload {{ grid }} lazyload"  data-include="{{url_cat}}/products/{{pr_hd}}/?view=pr_lazy_load">                      

                    </div>
                    {%- endfor -%}
                  {%- else -%}
                    {%- for i in (1..section.settings.max_count ) -%}
                    <div class="grid__item {{ grid }}">
                      <div class="product-item">
                        <div class="product-image">
                          <a href="/admin/products" class="product__image-wrapper">
                            {% capture current %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}
                            {{ 'product-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                          </a>
                        </div>
                        <div class="product-info">
                          <div class="product__title"><a href="/admin/products">{{ 'homepage.onboarding.product_title' | t | capitalize }}</a></div>
                          <div class="product__price">$19.99</div>
                        </div>
                      </div>

                    </div>
                    {%- endfor -%} 
                  {%- endif -%}
                </div>
              {%if dots %}
              <div class="laber_append_dots"></div>
              {%endif%}
              {%- endfor -%}
            </div>
          </div>
          {%- endif -%}

        </div>
      </div>
    </div>
  </div>
</section>
{%- endfor -%}
{%- render 'section_style' -%}


{%- schema -%}
  {
    "name": "Tab Products carousel 3",
    "class": "cms_section type_carousel tab-product type_tab_collection product_section tab_product_style3",
    "max_blocks": 10,
    "settings": [
      {
        "type": "header",
        "content": "== Title Settings"
      },
      {
        "type": "text",
        "id": "title",
        "label": "Heading",
        "default": "New arrivals"
      },
      {
        "type": "text",
        "id": "sub_title",
        "label": "Sub Text"
      },  
      {
      "type": "select",
      "id": "tab-pos",
      "default": "col-right",
      "options": [
      {
      "value": "col-left",
      "label": "Left"
      },
      {
      "value": "col-right",
      "label": "Right"
      }
      ],
      "label": "tab position"
      },
      {
      "type": "color",
      "id": "color_bg",
      "label": "Background color",
      "default": "#1e4d9c"
      },
      {
      "type": "image_picker",
      "id": "bg",
      "label": "Background image",
      "info": "552 x 425 .jpg recommended"
      },	
      {
        "type": "checkbox",
        "id": "show_view_all",
        "label":"Show View all button",
        "default": false
      },  
      {
        "type": "text",
        "id": "text_button",
        "label": "Button",
        "default": "Shop for women’s"
      },
      {
      "type": "url",
      "id": "btn_link",
      "label": "Button link",
      "info": "Note: if you want to display this button then you need to fill button link"
      }, 
      {
      "type": "select",
      "id": "open_link",
      "options": [
      {
      "value": "_self",
      "label": "Current window (_self)"
      },
      {
      "value": "_blank",
      "label": "New window (_blank)"
      }
      ],
      "label": "Open link in",
      "default": "_blank"
      },
      {
        "type": "header",
        "content": "== General Settings"
      },     
      {
        "type": "range",
        "id": "max_count",
        "min": 1,
        "max": 24,
        "step": 1,
        "unit": "pds",
        "label": "Max product",
        "default": 8
      },
	  {
        "type": "range",
        "id": "col_pr",
        "min": 1,
        "max": 10,
        "step": 1,
        "unit": "pds",
        "label": "Product per row (desktop)",
		"info": "How many products you want to show per row",
        "default": 4
      },
	  {
        "type": "range",
        "id": "col_pr_tab_pro",
        "min": 1,
        "max": 10,
        "step": 1,
        "unit": "pds",
        "label": "Product per row (tablet Pro)",
        "default": 3
      },	
	  {
        "type": "range",
        "id": "col_pr_tab",
        "min": 1,
        "max": 10,
        "step": 1,
        "unit": "pds",
        "label": "Product per row (tablet)",
        "default": 3
      },
      {
        "type": "range",
        "id": "col_pr_mob",
        "min": 1,
        "max": 10,
        "step": 1,
        "unit": "pds",
       "label": "Columns (Mobile horizontal screen)",
        "default": 2
      },
	  {
        "type": "range",
        "id": "col_pr_mob_vertical",
        "min": 1,
        "max": 10,
        "step": 1,
        "unit": "pds",
        "label": "Columns (Mobile Vertical screen)",
        "default": 2
      },
	  {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
      },
	  {	
      "type": "checkbox",
      "id": "arrows",
      "label": "Arrows",
      "default": true
      },
	  {	
      "type": "checkbox",
      "id": "dots",
      "label": "Dots",
      "default": true
      },
	  {	
      "type": "checkbox",
      "id": "infinite",
      "label": "Infinite",
      "default": false,
	  "info":"Infinity loop. Duplicate last and first items to get loop illusion."	
      },	
            
      {
        "type": "header",
        "content": "== Design Options"
      },      
      {
        "type": "select",
        "id": "layout",
        "default": "container",
        "options": [
         {
            "value": "container",
            "label": "Container"
         },
         {
            "value": "full-width",
            "label": "Full Width"
          }
        ],
        "label": "Layout"
      },
      {
        "type": "color",
        "id": "cl_bg",
        "label": "Background color",
        "default": "#fff"
      },
 	  {
        "type": "header",
        "content": "== Setting PC",
		"info":"Margin"
      },	
      {
        "type": "text",
        "id": "mg",
        "label": "Margin",
		"placeholder": "0,0,0,0",
        "info":"Margin top, margin right, margin bottom, margin left. If you not use to blank"
      },
      {
        "type": "text",
        "id": "pd",
        "label": "Padding",
		"placeholder": "0,0,0,0",
        "info":"Padding top, padding right, padding bottom, padding left. If you not use to blank"
      },
     {
        "type": "header",
        "content": "== Design Mobile Options"
      },
      {
        "type": "text",
        "id": "mg_mb",
		"placeholder": "0,0,0,0",
        "label": "Margin"
      },
      {
        "type": "text",
        "id": "pd_mb",
		"placeholder": "0,0,0,0",
        "label": "Padding"
      }
    ],
    "blocks": [
      {
        "type": "col",
        "name": "Collection",
        "limit": 10,
        "settings": [          
            {
              "type": "text",
              "id": "title",
              "label": "Title",
			  "default": "Tab product"
            },
            {
              "type": "collection",
              "id": "collection",
              "label": "Collection"
            }
        ]
      }
      
    ],
    "presets": [
      {
        "name": "Tab Products carousel style3",
        "category": "Collections",
        "blocks": [
          {
            "type": "col"
          },
          {
            "type": "col"
          },
          {
            "type": "col"
          }          
        ]
      }
    ]
  }
{% endschema %}
