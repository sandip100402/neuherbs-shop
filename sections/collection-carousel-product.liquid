{% liquid
  assign id = section.id 
    assign sett_equal = section.settings.use_eq_height
    assign image_ratio = section.settings.image_ratio
  assign layout_des = section.settings.layout_des
  assign collection = section.settings.collection 

    assign cl_bg =section.settings.cl_bg 
    
    assign mg_top_minus =section.settings.mg_top_minus |plus:0
	assign mg_top =section.settings.mg_top |plus:0
    assign mobile_mg_top_minus =section.settings.mobile_mg_top_minus |plus:0
    assign mobile_mg_top =section.settings.mobile_mg_top |plus:0
    assign mg_bottom =section.settings.mg_bottom |plus:0
    assign mobile_mg_bottom =section.settings.mobile_mg_bottom |plus:0
 	assign pd_top =section.settings.pd_top |plus:0
    assign mobile_pd_top =section.settings.mobile_pd_top |plus:0
    assign pd_bottom =section.settings.pd_bottom |plus:0
    assign mobile_pd_bottom =section.settings.mobile_pd_bottom |plus:0
    
    assign col_pr =section.settings.col_pr |plus:0
    assign col_ipad_pro =section.settings.col_ipad_pro |plus:0
    assign col_ipad =section.settings.col_ipad |plus:0
    assign col_mobile =section.settings.col_mobile |plus:0
    assign col_mobile_vertical =section.settings.col_mobile_vertical |plus:0
    
    if col_pr == 5
    	assign col = 15
    else
    	assign col = 12 | divided_by: col_pr
    endif
    
  assign autoplay =  section.settings.autoplay
  assign arrows =  section.settings.arrows
  assign dots =  section.settings.dots
  assign infinite =  section.settings.infinite
  
  
%}
   
{%- for i in (1..1) -%}  
<section id="laber_{{id}}" class="wow animate--slide-in use_lines" style="--color-border:#e5e5e5">
  <div class="alo__product_section">
    <div class="{{section.settings.layout}}">
		<div class="wrap_title ">
          
		  {% if section.settings.sub_title!= blank %}
		  <span class="section-subtitle">{{section.settings.sub_title}}</span>
		  {% endif %}
          
          {% if section.settings.title != blank %}
		  <h3 class="section-title">{{section.settings.title}}</h3>  
		  {% endif %}
          
          
          {% if section.settings.content!= blank %}
		  <div class="content">{{section.settings.content}}</div>
		  {% endif %}
          
		</div>
    <div class="products-arrivals ">
      {%- if collection  != blank -%} 
          <div class="section-content">
            {% capture grid %}col-xs-6 col-sm-6 col-md-4 col-lg-{{ col }}{% endcapture %}              
            <div class="content_section slick-carousel">
               <div class="grid-slider js_carousel collection-slider laber-slick-carousel {%if sett_equal%}{{image_ratio}} {%endif%}"  
     data-adaptive-height="true" data-autoplay="true" data-autoplay-speed="3000" data-arrows="false" data-center-mode="false" data-dots="true" data-fade="false" data-infinite="false" data-padding="5" data-rows="1" data-slides-to-show="6" data-slides-to-scroll="1" data-speed="700" data-vertical="false" data-vertical-swiping="false" data-responsive="[{&quot;breakpoint&quot;: 1921, &quot;settings&quot;: {&quot;slidesToShow&quot;:  6 }},{&quot;breakpoint&quot;: 1920, &quot;settings&quot;: {&quot;slidesToShow&quot;:  5 }},{&quot;breakpoint&quot;: 1480, &quot;settings&quot;: {&quot;slidesToShow&quot;:  5 }},{&quot;breakpoint&quot;: 1200, &quot;settings&quot;: {&quot;slidesToShow&quot;:  4 }},{&quot;breakpoint&quot;: 992, &quot;settings&quot;: {&quot;slidesToShow&quot;:  3 }},{&quot;breakpoint&quot;: 768, &quot;settings&quot;: {&quot;slidesToShow&quot;:  3 }},{&quot;breakpoint&quot;: 576, &quot;settings&quot;: {&quot;slidesToShow&quot;:  2 }},{&quot;breakpoint&quot;: 481, &quot;settings&quot;: {&quot;slidesToShow&quot;:  2 }},{&quot;breakpoint&quot;: 361, &quot;settings&quot;: {&quot;slidesToShow&quot;:  2 }},{&quot;breakpoint&quot;: 1, &quot;settings&quot;: {&quot;slidesToShow&quot;:  1 }}]" data-mobile="2" data-portrait="2" data-landscape="2" data-tablet="3" data-notebook="3" data-laptop="4" data-desktop="5" data-widescreen="5" data-visible="6" data-spacing="10"
   data-append-Arrows=".arrows_{{ section.id }}" data-append-Dots=".dots_{{section.id}}" > 
              {%- assign products = collections[collection].products -%}
              {%- capture url_cat -%}{%- if routes.root_url != '/' -%}{{routes.root_url}}{%- endif -%}{% if collection %}/collections/{{collection.handle}}{% endif %}{%- endcapture -%}
              {%- for product in products limit: section.settings.max_count -%}
              
              {% assign pr_hd = product.handle %}
                <div data-lazy-product-load class="productLazyload {% if products.size >= section.settings.max_count %}{{ grid }} {% else %} col-sm-12 {% endif %} lazyload" data-include="{{url_cat}}/products/{{pr_hd}}/?view=pr_lazy_load">                      

                </div>
              {%- endfor -%}  
              
            </div>
            </div>
            {%if dots %}
            	<div class="laber_append_dots"></div>
            {%endif%}
          </div>
          {%if section.settings.show_view_all %}
      		<div class="bn_button viewall text-center"><a href="{{ collections[collection].url | default:'/admin/collections' }}">{{'collections.general.view_all' |t}}</a></div>
      		{%endif%}
      {%- else -%}
      {% capture grid %}col-xs-6 col-sm-6 col-md-4 col-lg-{{ col }}{% endcapture %}
      	<div class="js-slick-carousel laber-slick-carousel products-slider row" 
             
             data-slidestoshow="{{col_pr}}" 
             data-slidestoscroll="{{col_pr}}" 

             data-slidestoshowipadpro="{{col_ipad_pro}}" 
             data-slidestoscrollipadpro="{{col_ipad_pro}}"

             data-slidestoshowipad="{{col_ipad}}" 
             data-slidestoscrollipad="{{col_ipad}}"

             data-slidestoshowmobile="{{col_mobile}}" 
             data-slidestoscrollmobile="{{col_mobile}}"

             data-slidestoshowmobilevertical="{{col_mobile_vertical}}" 
             data-slidestoscrollmobilevertical="{{col_mobile_vertical}}"
                 
              data-arrows="{{arrows}}" 
              data-dots="{{dots}}" 
              data-autoplay="{{autoplay}}"
              data-infinite="{{infinite}}">
          
		{%- for i in (1..16) -%}
                <div class="pr_grid_item {{grid}}">
                  <div class="product-inner">
                    <div class="product-image">
                      	<a href="/admin/products" class="product__image-wrapper">
                        	{% capture current %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}
                            {{ 'product-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                        </a>
                    </div>
                  </div>
                  <div class="product-collection__content">
                    <h3 class="product-collection__title">
                      	<a class="cd" href="/admin/products">{{ 'homepage.onboarding.product_title' | t }}</a>
                   	</h3>
                    
                    <span class="price price--sale">
                      	<span class="compare"><span class="money">$39.00</span></span>
                      	<span class="current"><span class="money">$59.00</span></span>
                      
                    </span>
                  </div>
                </div>
             {%- endfor -%}   
      	</div>
        {%if dots %}
          <div class="laber_append_dots"></div>
      {%endif%}
      {%- endif -%}
    </div>
  </div>
  </div>
</section>
{%- endfor -%}
{%- render 'section_style' -%}
{%- schema -%}
  {
    "name": "Carousel Products style 1",
    "class": "laber_section cms_section type_carousel product_section collection_carousel_style1",
    "settings": [
      {
        "type": "header",
        "content": "== Title Settings"
      },
      {
        "type": "text",
        "id": "title",
        "label": "Heading",
        "default": "New arrivals"
      },
      {
        "type": "text",
        "id": "sub_title",
        "label": "Sub Text"
      },  
	  {
        "type": "textarea",
        "id": "content",
        "label": "Content",
        "default": "Commodo sociosqu venenatis cras dolor sagittis integer luctus maecenas."
      },  
      {
        "type": "header",
        "content": "== General Settings"
      },     
      {
        "type": "collection",
        "id": "collection",
        "label": "Collection"
      },
		
      {
        "type": "range",
        "id": "max_count",
        "min": 4,
        "max": 24,
        "step": 1,
        "unit": "pds",
        "label": "Max product",
        "default": 8
      },
	  {
        "type": "select",
        "id": "col_pr",
        "label": "Product per row",
        "info": "How many product you want to show per row (Layout design is grid)",
        "default": "4",
        "options": [
          {
            "value": "2",
            "label": "2"
          },
          {
            "value": "3",
            "label": "3"
          },
          {
            "value": "4",
            "label": "4"
          },
          {
            "value": "5",
            "label": "5"
          }
        ]
      },
      {
      "type": "select",
      "id": "col_ipad_pro",
      "label": "Columns (Ipad Pro)",
      "info": "How many item you want to show per row",
      "default": "4",
      "options": [
      {
      "value": "2",
      "label": "2"
      },
      {
      "value": "3",
      "label": "3"
      },
      {
      "value": "4",
      "label": "4"
      }
      ]
      },
	  {
      "type": "select",
      "id": "col_ipad",
      "label": "Columns (Ipad)",
      "info": "How many item you want to show per row",
      "default": "2",
      "options": [
      {
      "value": "2",
      "label": "2"
      },
      {
      "value": "3",
      "label": "3"
      },
      {
      "value": "4",
      "label": "4"
      }
      ]
      },	
      {
      "type": "select",
      "id": "col_mobile",
      "label": "Columns (Mobile horizontal screen)",
      "default": "1",
      "options": [
      {
      "value": "1",
      "label": "1"
      },
      {
      "value": "2",
      "label": "2"
      }
      ]
      },
      {
      "type": "select",
      "id": "col_mobile_vertical",
      "label": "Columns (Mobile Vertical screen)",
      "default": "1",
      "options": [
      {
      "value": "1",
      "label": "1"
      },
      {
      "value": "2",
      "label": "2"
      }
      ]
      },
      {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
      },
	  {	
      "type": "checkbox",
      "id": "arrows",
      "label": "Arrows",
      "default": true
      },
	  {	
      "type": "checkbox",
      "id": "dots",
      "label": "Dots",
      "default": true
      },
	  {	
      "type": "checkbox",
      "id": "infinite",
      "label": "Infinite",
      "default": false,
	  "info":"Infinity loop. Duplicate last and first items to get loop illusion."	
      },
	  {
        "type": "checkbox",
        "id": "show_view_all",
        "label":"Show View all button",
        "default": false
      }, 
      {
        "type": "header",
        "content": "== Design Options"
      },      
      {
        "type": "select",
        "id": "layout",
        "default": "container",
        "options": [
         {
            "value": "container",
            "label": "Container"
         },
         {
            "value": "full-Width",
            "label": "Full Width"
          }
        ],
        "label": "Layout"
      },
      {
        "type": "color",
        "id": "cl_bg",
        "label": "Background color",
        "default": "#fff"
      },
	  {
        "type": "checkbox",
        "id": "use_eq_height",
        "label": "Use equal height images?",
        "default": false
      },
      {
        "type": "select",
        "id": "image_ratio",
        "label": "Aspect Ratio",
        "default": "ratio3_2",
        "info": "Aspect Ratio Custom will settings in General panel.",
        "options": [
          {
            "group": "Landscape",
            "value": "ratio2_1",
            "label": "2:1"
          },
          {
            "group": "Landscape",
            "value": "ratio16_9",
            "label": "16:9"
          },
          {
            "group": "Landscape",
            "value": "ratio8_5",
            "label": "8:5"
          },
          {
            "group": "Landscape",
            "value": "ratio3_2",
            "label": "3:2"
          },
          {
            "group": "Landscape",
            "value": "ratio4_3",
            "label": "4:3"
          },
          {
            "group": "Landscape",
            "value": "ratio_nt",
            "label": "Ratio ASOS"
          },
          {
            "group": "Squared",
            "value": "ratio1_1",
            "label": "1:1"
          },
          {
            "group": "Portrait",
            "value": "ratio2_3",
            "label": "2:3"
          },
          {
            "group": "Portrait",
            "value": "ratio1_2",
            "label": "1:2"
          },
		   {
            "group": "Custom",
            "value": "ratio_custom_1",
            "label": "Custom 1(128%)"
          }
        ]
      }, 
 	  {
        "type": "header",
        "content": "== Setting PC",
		"info":"Margin"
      },	
      {
        "type": "text",
        "id": "mg",
        "label": "Margin",
		"placeholder": "0,0,0,0",
        "info":"Margin top, margin right, margin bottom, margin left. If you not use to blank"
      },
      {
        "type": "text",
        "id": "pd",
        "label": "Padding",
		"placeholder": "0,0,0,0",
        "info":"Padding top, padding right, padding bottom, padding left. If you not use to blank"
      },
     {
        "type": "header",
        "content": "== Design Mobile Options"
      },
      {
        "type": "text",
        "id": "mg_mb",
		"placeholder": "0,0,0,0",
        "label": "Margin"
      },
      {
        "type": "text",
        "id": "pd_mb",
		"placeholder": "0,0,0,0",
        "label": "Padding"
      }    
    ],
    "presets": [
      {
        "name": "Carousel products style1",
        "category": "Collections"
      }
    ]
  }
{% endschema %}
