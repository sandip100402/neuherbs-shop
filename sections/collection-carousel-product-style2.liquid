{% liquid
  assign sid = section.id 
  assign layout = section.settings.layout
    assign sett_equal = section.settings.use_eq_height
    assign image_ratio = section.settings.image_ratio
  assign collection = section.settings.collection 

    assign cl_bg =section.settings.cl_bg 
    
    assign mg_top_minus =section.settings.mg_top_minus |plus:0
	assign mg_top =section.settings.mg_top |plus:0
    assign mobile_mg_top_minus =section.settings.mobile_mg_top_minus |plus:0
    assign mobile_mg_top =section.settings.mobile_mg_top |plus:0
    assign mg_bottom =section.settings.mg_bottom |plus:0
    assign mobile_mg_bottom =section.settings.mobile_mg_bottom |plus:0
 	assign pd_top =section.settings.pd_top |plus:0
    assign mobile_pd_top =section.settings.mobile_pd_top |plus:0
    assign pd_bottom =section.settings.pd_bottom |plus:0
    assign mobile_pd_bottom =section.settings.mobile_pd_bottom |plus:0
    
    assign col_pr =section.settings.col_pr |plus:0
    assign col_ipad_pro =section.settings.col_ipad_pro |plus:0
    assign col_ipad =section.settings.col_ipad |plus:0
    assign col_mobile =section.settings.col_mobile |plus:0
    assign col_mobile_vertical =section.settings.col_mobile_vertical |plus:0
    
    if col_pr == 5
    	assign col = 15
    else
    	assign col = 12 | divided_by: col_pr
    endif
    
  assign autoplay =  section.settings.autoplay
  assign arrows =  section.settings.arrows
  assign dots =  section.settings.dots
  assign infinite =  section.settings.infinite
  
  
%}
   
{%- for i in (1..1) -%}  
<section id="laber_{{sid}}">
  <div class="laber_product_section_{{sid}}">
    <div class="container {%if layout == 'full-width' %}{{layout}}{%endif%}">
     <div class="row">
       <div class="{{section.settings.position}} col-xs-12 col-sm-12 col-md-12 col-lg-5">
         <div class="product-left"
              style="
                                         {% if section.settings.color_bg != blank %}background-color:{{section.settings.color_bg}};{%endif%}
                                         {% if section.settings.bg != blank %}background-image: url('{{ section.settings.bg | img_url:"552x"}}');{%endif%}">
           <div class="wrap_title ">
             {% if section.settings.sub_title!= blank %}
             <span class="section-subtitle">{{section.settings.sub_title}}</span>
             {% endif %}

             {% if section.settings.title != blank %}
             <h3 class="section-title">{{section.settings.title}}</h3>  
             {% endif %}
             <div class="menu">
               {%- assign menu = section.settings.menu -%}
               {%- if menu != blank -%}
               <ul>
                 {%- for link in linklists[menu].links limit:5 -%}
                 <li class="item{% if link.active %}active{% endif %}">
                   <a href="{{ link.url }}">{{ link.title | split: '[' | first }}

                     {% if link.object.all_products_count %}
                     <span class="n_pro">({{ link.object.all_products_count }})</span>
                     {%endif%}
                   </a>
                 </li>
                 {%- endfor -%}
               </ul>
               {%- else -%}
               	<ul>
                  <li class="item"><a href="#">Running</a></li>
                  <li class="item"><a href="#">Basketball</a></li>
                  <li class="item"><a href="#">American Football</a></li>
                  <li class="item"><a href="#">Football</a></li>
                  <li class="item"><a href="#">Training & Gym</a></li>
               </ul>
               {%- endif -%}
             </div> 	
           </div>
           {%if section.settings.show_view_all %}
            <div class="bn_button viewall">
                  {%- if  section.settings.title != blank -%}
                      <a  class="buttons" href="{{section.settings.btn_link}}" target="{{block.settings.open_link}}">
                          {{section.settings.text_button}}
                      </a>
                  {%- endif -%}
             </div>
            {%endif%}
         </div>
       </div>
       <div class="col-xs-12 col-sm-12 col-md-12 col-lg-7">
       <div class="products-arrivals ">
         {%- if collection  != blank -%} 
         <div class="section-content">
            {% include 'grid-slider', settings:section.settings %} 
            <div class="content_section slick-carousel">
            <div class="grid-slider collection-slider" {{gridSlider}} data-append-Arrows=".arrows_{{sid}}" data-append-Dots=".dots_{{sid}}" >
             {%- assign products = collections[collection].products -%}
             {%- capture url_cat -%}{%- if routes.root_url != '/' -%}{{routes.root_url}}{%- endif -%}{% if collection %}/collections/{{collection.handle}}{% endif %}{%- endcapture -%}
             {%- for product in products limit: section.settings.max_count -%}

             {% assign pr_hd = product.handle %}
             <div data-lazy-product-load class="productLazyload {% if products.size >= section.settings.max_count %} {% else %} col-sm-12 {% endif %} lazyload" data-include="{{url_cat}}/products/{{pr_hd}}/?view=pr_lazy_load">                      

             </div>
             {%- endfor -%}  

           </div>
            {%if dots %}
            <div class="laber_append_dots dots_{{sid}}"></div>
            {%endif%}
            {%if arrows%}	
            <div class="laber_append_arrows arrows_{{sid}}"></div>	
            {% endif %}
            </div>
         </div>
         {%- else -%}
                   {% include 'grid-slider', settings:section.settings %} 
    <div class="content_section slick-carousel">
    <div class="grid-slider collection-slider" {{gridSlider}} data-append-Arrows=".arrows_{{sid}}" data-append-Dots=".dots_{{sid}}" >

           {%- for i in (1..16) -%}
           <div class="pr_grid_item">
             <div class="product-item">
               <div class="product-image">
                 <a href="/admin/products" class="product__image-wrapper">
                   {% capture current %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}
                   {{ 'product-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                 </a>
               </div>
               <div class="product-collection__content">
                 <h3 class="product-collection__title">
                   <a class="cd" href="/admin/products">{{ 'homepage.onboarding.product_title' | t }}</a>
                 </h3>
                 <span class="price price--sale">
                   <span class="compare"><span class="money">$39.00</span></span>
                   <span class="current"><span class="money">$59.00</span></span>

                 </span>
               </div>
             </div>

           </div>
           {%- endfor -%}   
         </div>
      {%if dots %}
      <div class="laber_append_dots dots_{{sid}}"></div>
      {%endif%}
      {%if arrows%}	
      <div class="laber_append_arrows arrows_{{sid}}"></div>	
      {% endif %}
    </div>
         {%- endif -%}
       </div>
       </div>
      </div>
  </div>
  </div>
</section>
{%- endfor -%}
{%- render 'section_style' -%}
{%- schema -%}
  {
    "name": "Carousel Products style 2",
    "class": "laber_section cms_section type_carousel product_section collection_carousel_style2",
