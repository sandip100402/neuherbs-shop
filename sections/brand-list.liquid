{% liquid
    assign id = section.id  
    
      assign col_pr =section.settings.col_pr |plus:0
      assign col_ipad_pro =section.settings.col_ipad_pro |plus:0
      assign col_ipad =section.settings.col_ipad |plus:0
      assign col_mobile =section.settings.col_mobile |plus:0
      assign col_mobile_vertical =section.settings.col_mobile_vertical |plus:0
  
          if col_pr == 5
          assign col = 15
      else
          assign col = 12 | divided_by: col_pr
      endif
  
    assign autoplay =  section.settings.use_slideshow_autoplay
    assign arrows =  section.settings.nav_enable
    assign dots =  section.settings.dot_enable
    assign infinite =  section.settings.infinite
      
  %}
     
  {%- for i in (1..1) -%}  
    {%- if section.settings.hidden %}{% break %}{% endif -%}
  
   <section class="laber_brand_{{id}}">   
    <div class="{{section.settings.layout}}">
      <div class="wrap-section">
        {% if section.settings.title != blank or section.settings.sub_title!= blank %}
          <div class="wrap_title ">
            
            {% if section.settings.sub_title!= blank %}
                <span class="section-subtitle">{{section.settings.sub_title}}</span>
            {% endif %}
            
            {% if section.settings.title != blank %}
            <h3 class="section-title">{{section.settings.title}}</h3>  
            {% endif %}
            
            
            {% if section.settings.content!= blank %}
            <div class="content">{{section.settings.content}}</div>
            {% endif %}
            
          </div>
          {% endif %}
      </div>
      <div class="cms-wrap-brand2" {%if section.settings.show_border%}style="padding:20px 0;border-top:1px solid {{section.settings.cl_bg_border}}; border-bottom:1px solid {{section.settings.cl_bg_border}};"{%endif%}>       
              
                {% capture grid %}col-xs-6 col-sm-6 col-md-4 col-lg-{{ col }}{% endcapture %}
        
              <div class="grid-slider js_carousel laber-slick-carousel products-slider row" 
                   data-adaptive-height="true" 
                   data-autoplay="{{autoplay}}" 
                   data-autoplay-speed="3000" 
                   data-arrows="{{arrows}}" 
                   data-center-mode="false" 
                   data-dots="{{dots}}" 
                   data-fade="false" 
                   data-infinite="{{infinite}}" 
                   data-padding="10" 
                   data-rows="1" 
                   data-slides-to-show="{{col_pr}}" 
                   data-slides-to-scroll="{{col_pr}}" 
                   data-speed="700" 
                   data-vertical="false" 
                   data-vertical-swiping="false"
                   data-responsive="[{&quot;breakpoint&quot;: 1921, &quot;settings&quot;: {&quot;slidesToShow&quot;: {{col_pr}} }},{&quot;breakpoint&quot;: 1920, &quot;settings&quot;: {&quot;slidesToShow&quot;: {{col_ipad_pro}} }},{&quot;breakpoint&quot;: 1480, &quot;settings&quot;: {&quot;slidesToShow&quot;: {{col_ipad_pro}} }},{&quot;breakpoint&quot;: 1200, &quot;settings&quot;: {&quot;slidesToShow&quot;: {{col_ipad}} }},{&quot;breakpoint&quot;: 992, &quot;settings&quot;: {&quot;slidesToShow&quot;: {{col_ipad}} }},{&quot;breakpoint&quot;: 768, &quot;settings&quot;: {&quot;slidesToShow&quot;: {{col_mobile}} }},{&quot;breakpoint&quot;: 576, &quot;settings&quot;: {&quot;slidesToShow&quot;: {{col_mobile}} }},{&quot;breakpoint&quot;: 481, &quot;settings&quot;: {&quot;slidesToShow&quot;: {{col_mobile_vertical}} }},{&quot;breakpoint&quot;: 361, &quot;settings&quot;: {&quot;slidesToShow&quot;: {{col_mobile_vertical}} }},{&quot;breakpoint&quot;: 1, &quot;settings&quot;: {&quot;slidesToShow&quot;: 1 }}]"
                   data-append-Arrows=".laber_append_arrows_{{id}}" 
                   data-append-Dots=".laber_append_dots_{{id}}">
                
          {%- if section.blocks.size > 0 -%}
              {%- for block in section.blocks -%}
                {%- assign image = block.settings.image -%}
                {%- assign url = block.settings.url -%}
                <div class="cat_space_item brand_list {{grid}}">
                  {%- if url != blank -%}<a href="{{ url }}" class="db" target="{{block.settings.open_link}}">{%- endif -%}
                  {%- if image != blank %}
                        <div data-image-effect class="pr_lazy_img main-img lazyload laber_bg_lz" data-id="{{image.id}}" data-bgset="{{ image | img_url: '1x1' }}" data-parent-fit="width" data-wiis data-ratio="{{image.aspect_ratio}}" data-sizes="auto" style="padding-top:{{ 1 | divided_by: image.aspect_ratio | times: 100}}%;"></div>
                  {%- else -%}
                    <div class="lazyload laber_bg_lz pr_lazy_img" data-bgset="https://via.placeholder.com/142x70.png/{% cycle 'a8dacc', '56cfe1', 'f99077','c8b09b','efe1ba','a5d0d9','a1a19f' %}/fff?text=142x70"  data-sizes="auto" style="padding-top:70px;"></div>                   
                  {%- endif -%}
                  {%- if url != blank -%}</a>{%- endif -%}
                </div>
              {%- endfor -%}
          {% else %}
              {%- for i in (1..6) -%}
                <div class="cat_space_item brand_list {{grid}}">                                
                  <div class="lazyload laber_bg_lz pr_lazy_img" data-bgset="https://via.placeholder.com/142x70.png/{% cycle 'a8dacc', '56cfe1', 'f99077','c8b09b','efe1ba','a5d0d9','a1a19f' %}/fff?text=142x70"  data-sizes="auto" style="padding-top:70px;"></div>     
                </div>
              {%- endfor -%}             	
          {%- endif -%}
        </div>
        
        {% if arrows %}
            <div class="laber_append_arrows_{{id}}">
              <button type="button" class="slick-prev slick-arrow" aria-label="Previous">
                <i class="icon-arrow-left"></i>
              </button>
              <button type="button" class="slick-next slick-arrow" aria-label="Next">
                <i class="icon-arrow-right"></i>
              </button>
            </div>
        {% endif %}
        
        {% if dots %}
            <div class="laber_append_dots_{{id}}"></div>
        {% endif %}
      </div>
      
    </div>
  </section>
  
  {%- style -%}
        .laber_brand_{{id}}{
        margin-top:{{section.settings.mg_top}}px ;
        margin-bottom:{{section.settings.mg_bottom}}px ;
        padding-top:{{section.settings.pad_top}}px ;
        padding-bottom:{{section.settings.pad_bottom}}px;
        background-color:{{section.settings.cl_bg}};
        position: relative;
        }
        
        .laber_brand_{{id}} .cms-wrap-brand2 {
          position: relative;
        }
        
        .laber_brand_{{id}} .laber_append_arrows {
          position: absolute;
          top: 50%;
          transform: translateY(-50%);
          width: 100%;
          pointer-events: none;
          z-index: 10;
        }
        
        .laber_brand_{{id}} .slick-arrow {
          position: absolute;
          top: 50%;
          transform: translateY(-50%);
          width: 40px;
          height: 40px;
          background: rgba(255,255,255,0.9);
          border: 1px solid #ddd;
          border-radius: 50%;
          cursor: pointer;
          pointer-events: auto;
          z-index: 10;
          transition: all 0.3s ease;
          display: flex;
          align-items: center;
          justify-content: center;
        }
        
        .laber_brand_{{id}} .slick-arrow:hover {
          background: #fff;
          border-color: #000;
          transform: translateY(-50%) scale(1.1);
        }
        
        .laber_brand_{{id}} .slick-prev {
          left: -20px;
        }
        
        .laber_brand_{{id}} .slick-next {
          right: -20px;
        }
        
        .laber_brand_{{id}} .slick-arrow i {
          font-size: 16px;
          line-height: 1;
          text-align: center;
          display: block;
        }
        
        .laber_brand_{{id}} .slick-dots {
          text-align: center;
          margin-top: 20px;
        }
        
        .laber_brand_{{id}} .slick-dots li {
          display: inline-block;
          margin: 0 5px;
        }
        
        .laber_brand_{{id}} .slick-dots li button {
          width: 10px;
          height: 10px;
          border-radius: 50%;
          background: #ccc;
          border: none;
          font-size: 0;
          cursor: pointer;
          transition: all 0.3s ease;
        }
        
        .laber_brand_{{id}} .slick-dots li.slick-active button {
          background: #000;
        }
        
        .laber_brand_{{id}} .brand_list {
          padding: 10px;
          text-align: center;
        }
        
        .laber_brand_{{id}} .brand_list img {
          max-width: 100%;
          height: auto;
          transition: all 0.3s ease;
        }
        
        .laber_brand_{{id}} .brand_list:hover img {
          transform: scale(1.05);
        }
        
    @media (max-width: 767px) {
        .laber_brand_{{id}}{
        margin-top:{{section.settings.mobile_mg_top}}px ;
        margin-bottom:{{section.settings.mobile_mg_bottom}}px ;
        padding-top:{{section.settings.mobile_pd_top}}px ;
        padding-bottom:{{section.settings.mobile_pd_bottom}}px;
        }
        
        .laber_brand_{{id}} .slick-arrow {
          width: 35px;
          height: 35px;
        }
        
        .laber_brand_{{id}} .slick-prev {
          left: -17px;
        }
        
        .laber_brand_{{id}} .slick-next {
          right: -17px;
        }
        
        .laber_brand_{{id}} .slick-arrow i {
          font-size: 14px;
        }
    }
  {%- endstyle -%}
  
  {%- endfor -%} 
  
  {%- schema -%}
    {
      "name": "Brand list",
      "class": "laber_section brand_list type_brand_list type_carousel zoom_img",
      "max_blocks": 30,
      "settings": [
        {
          "type": "header",
          "content": "== Design Options"
        },
        {
          "type": "checkbox",
          "id": "hidden",
          "label": "Hidden Section?",
          "default": false
        },      
        {
          "type": "select",
          "id": "layout",
          "default": "container",
          "options": [
           {
              "value": "container",
              "label": "Container"
           },
           {
              "value": "nt_full",
              "label": "Full Width"
            }
          ],
          "label": "Layout"
        },
        {
          "type": "color",
          "id": "cl_bg",
          "label": "Background color",
          "default": "#fff"
        },
        {
          "type": "checkbox",
          "id": "show_border",
          "label": "Show border top and bottom",
          "default": false
        },
        {
          "type": "color",
          "id": "cl_bg_border",
          "label": "Border color",
          "default": "#cccccc"
        },	
        {
          "type": "range",
          "id": "mg_top",
          "label": "Margin top",
          "default": 0,
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px"
        },
          {
          "type": "range",
          "id": "mg_bottom",
          "label": "Margin bottom",
          "default": 0,
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "pad_top",
          "label": "Padding Top",
          "default": 0,
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px"
        },
        
        {
          "type": "range",
          "id": "pad_bottom",
          "label": "Padding Bottom",
          "default": 0,
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "header",
          "content": "== Setting mobile",
          "info":"Padding and Margin"
        },
       {
          "type": "range",
          "id": "mobile_mg_top",
          "label": "Margin top",
          "default": 0,
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "mobile_mg_bottom",
          "label": "Margin bottom",
          "default": 0,
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "mobile_pd_top",
          "label": "Padding top",
          "default": 0,
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "mobile_pd_bottom",
          "label": "Padding bottom",
          "default": 0,
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "header",
          "content": "== General Settings"
        },  
        {
          "type": "text",
          "id": "title",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "sub_title",
          "label": "Sub Text"
        },
        {
          "type": "textarea",
          "id": "content",
          "label": "Content",
          "default": "Commodo sociosqu venenatis cras dolor sagittis integer luctus maecenas."
        },
        {
          "type": "header",
          "content": "== Slider Settings"
        }, 
        {
          "type": "select",
          "id": "col_pr",
          "label": "Brand columns (desktop)",
          "info": "How many brand you want to show",
          "default": "6",
          "options": [
            {
              "value": "1",
              "label": "1"
            },
            {
              "value": "2",
              "label": "2"
            },
            {
              "value": "3",
              "label": "3"
            },
            {
              "value": "4",
              "label": "4"
            },
            {
              "value": "5",
              "label": "5"
            },
            {
              "value": "6",
              "label": "6"
            }
          ]
        },
        {
        "type": "select",
        "id": "col_ipad_pro",
        "label": "Columns (Ipad Pro)",
        "info": "How many item you want to show per row",
        "default": "4",
        "options": [
        {
        "value": "2",
        "label": "2"
        },
        {
        "value": "3",
        "label": "3"
        },
        {
        "value": "4",
        "label": "4"
        }
        ]
        },
        {
        "type": "select",
        "id": "col_ipad",
        "label": "Columns (Ipad)",
        "info": "How many item you want to show per row",
        "default": "2",
        "options": [
        {
        "value": "2",
        "label": "2"
        },
        {
        "value": "3",
        "label": "3"
        },
        {
        "value": "4",
        "label": "4"
        }
        ]
        },	
        {
        "type": "select",
        "id": "col_mobile",
        "label": "Columns (Mobile horizontal screen)",
        "default": "1",
        "options": [
        {
        "value": "1",
        "label": "1"
        },
        {
        "value": "2",
        "label": "2"
        }
        ]
        },
        {
        "type": "select",
        "id": "col_mobile_vertical",
        "label": "Columns (Mobile Vertical screen)",
        "default": "1",
        "options": [
        {
        "value": "1",
        "label": "1"
        },
        {
        "value": "2",
        "label": "2"
        }
        ]
        },
  
        {
            "type": "checkbox",
            "id": "use_slideshow_autoplay",
            "label": "Use autoplay for slider",
            "default": false
          },
                {	
        "type": "checkbox",
        "id": "infinite",
        "label": "Infinite",
        "default": false,
        "info":"Infinity loop. Duplicate last and first items to get loop illusion."	
        },
          {
            "type": "header",
            "content": "== Prev Next Button, Page Dot Settings"
          },        
          {
            "type": "paragraph",
            "content": "Prev Next Button:"
          },
          {
            "type": "checkbox",
            "id": "nav_enable",
            "label": "Enable Prev Next Button?",
            "info": "Creates and enables previous & next buttons.",
            "default": true
          },
          {
            "type": "checkbox",
            "id": "dot_enable",
            "label": "Enable dot?",
            "info": "Creates and enables dot.",
            "default": false
          }
      ],
      "blocks": [{
      "type": "brand",
      "name": "Brand",
      "settings": [
        {
           "type": "image_picker",
           "id": "image",
           "label": "Image",
           "info": "Dimension: 1170 x 70 px"
         },
         {
          "label": "Link to (Optional)",
          "id": "url",
          "type": "url"
        },
        {
          "type": "select",
          "id": "open_link",
          "options": [
            {
              "value": "_self",
              "label": "Current window (_self)"
            },
           {
              "value": "_blank",
              "label": "New window (_blank)"
            }
          ],
          "label": "Open link in",
          "default": "_blank"
        }
        ]
      }],
      "presets": [
        {
          "name": "Brand list",
          "category": "Images",
          "blocks": [
            { "type": "brand" },
            { "type": "brand" },
            { "type": "brand" },
            { "type": "brand" },
            { "type": "brand" },
            { "type": "brand" },
            { "type": "brand" },
            { "type": "brand" },
            { "type": "brand" }
          ]
        }
      ]
    }
  {% endschema %} 