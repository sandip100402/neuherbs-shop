<style>
/* Mobile responsive */
@media only screen and (max-width : 767px){
   .col-auto.sticky_atc_thumb,
  .sticky_atc_wrapper .sticky_atc_btn .quantity,
  .sticky_atc_wrapper .col{
    display: none;
  }
  .col-auto.sticky_atc_btn.variations_form,
  .sticky_atc_btn .single_add_to_cart_button {
    width: 100%;
    margin: 0;
    max-width: 100%;
  }
}
.sticky_variant_content select {
    background: #f7fafb;
    min-width: 200px;
    max-height: 45px;
    border: 1px solid #f1f5f6;
    border-radius: var(--alo-border-radius);
    width: 269px;
    height: 45px;
    font-weight: 500;
    font-size: 14px;
    line-height: 18px;
    padding: 0 20px;
    color: #515d66;
    cursor: pointer;
    background-color: #f1f5f6;
    text-transform: capitalize;
    
  appearance: none;
  -webkit-appearance: none;
  -moz-appearance: none;
}
.sticky_variant_content {
  position: relative;
  display: inline-block;
}

/* custom icon using before */
.sticky_variant_content::before {
  content: "\e94f"; /* down arrow */
  font-family: icon-dukamarket !important;
  position: absolute;
  right: 15px;
  top: 0;
  bottom: 0;
  line-height: 45px;
  font-size: 14px;
  color: #515d66;
  pointer-events: none;
}

.single_add_to_cart_button{
min-width: 250px;
}
.col.sticky_variant_content {
    text-align: end;
    padding-right: 10px;
}
.sticky_atc_wrapper .quantity input.input-text[type=number] {
    -moz-appearance: textfield;
    border: none;
    height: 45px;
    text-align: center;
    color: var(--color-main);
    background: transparent;
    width: 40px;
    font-weight: 500;
    font-size: 14px;
    line-height: 45px;
}
</style>

{%- liquid
   assign currently = product.selected_or_first_available_variant
   assign cu_pr = currently.price
   assign cp_pr = currently.compare_at_price | default:cu_pr
   assign image = currently.featured_image | default:product.featured_image
   assign pr_variants = product.variants 
   assign available_v = pr_variants | where: "available"
   assign available_v_1 = available_v.first
   assign cur_var_id = currently.id
   assign pid = product.id
   assign hd_up = 'group-' |append:pid
   assign nav_up = linklists[hd_up].links | where:'type','product_link'
   assign nav_up_size = nav_up.size 
-%}

<div class="js_sticky_atc_wrapper sticky_atc_wrapper" {% include 'product-get-attributes' %}>
   <div class="container">
      <form method="post" action="/cart/add" class="row row-0 js_sticky_atc_form align-items-center">

         <!-- Product Thumb + Info -->
         <div class="col-auto sticky_atc_thumb" data-js-product-image>
            {%- assign img_url = image | img_url: '1x1' | replace: '_1x1.', '_{width}x.' -%}
            <img data-image-lazy alt="{{product.title | escape}}" 
                 data-src="{{ img_url }}" data-widths="[75, 150]" 
                 data-sizes="auto" class="js_fgr_img pr_lazy_img lazyload " 
                 src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="> 
         </div>

         <div class="col sticky_atc_info">
            <h4>{{ product.title }}</h4>
            <div class="sticky_atc_price" data-js-product-price>
              {% if cp_pr > cu_pr %}
                 <span class="current">{{ cu_pr | money }}</span>
                 <span class="compare">{{ cp_pr | money }}</span>
              {% else %}
                 {{ cu_pr | money }}
              {% endif %}
            </div>
         </div>

         <!-- Variant Dropdown -->
         <div class="col sticky_variant_content">
            {%- if available_v.size < 2 -%}
               <input class="js_sticky_sl" name="id" value="{{ available_v_1.id }}" type="hidden">
            {%- else -%}
               <select name="id" class="js_sticky_sl form-control" data-select-sticky_atc> 
                  {%- for variant in available_v -%}
                     <option 
                        data-img="{{variant.image | default:product.featured_image | img_url: '1x1'}}" 
                        data-ogprice="{{variant.compare_at_price |default:variant.price}}" 
                        data-price="{{variant.price}}" 
                        value="{{ variant.id }}"
                        {% if variant.id == cur_var_id %} selected="selected"{% endif %}>
                        {{ variant.title | escape }}
                     </option>
                  {%- endfor -%}
               </select>
            {%- endif -%}
         </div>

         <!-- Quantity + Add to cart -->
         <div class="col-auto sticky_atc_btn variations_form d-flex align-items-center">
            <div data-product-quantity class="js-quantity quantity mr-2">
               <input type="number" class="input-text js_sticky_qty js_qty" 
                      data-step="1" data-min="1" 
                      data-max="{% if currently.inventory_management != null %}{{currently.inventory_quantity}}{% else %}9999{% endif %}" 
                      name="quantity" value="1" size="4" pattern="[0-9]*" inputmode="numeric">
               <div class="qty"> 
                  <a rel="nofollow" data-no-instant class="js_plus plus" href="#"> <i class="icon-plus"></i> </a> 
                  <a rel="nofollow" data-no-instant class="js_minus minus" href="#"> <i class="icon-minus"></i> </a>
               </div>
            </div>

            <button type="submit" data-js-product-button-add-to-cart class="single_add_to_cart_button sticky_atc_js">
               <span class="txt_add_to_cart">{{ 'products.product.add_to_cart' | t }}</span>
               <span class="txt_out_stock d-none">{{ 'products.product.out_stock' | t }}</span>
            </button>
         </div>

      </form>
   </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function(){
  var variantSelect = document.querySelector(".js_sticky_sl");
  var hiddenInput = document.querySelector(".js_sticky_sl[name='id']");
  if(variantSelect){
    variantSelect.addEventListener("change", function(){
      var val = this.value;
      if(hiddenInput){ hiddenInput.value = val; }
    });
  }
});
</script>
