{% liquid
  assign sid = section.id
%}

<section id="laber_se_{{ sid }}" class="brand_list type_carousel zoom_img">
  <div class="{% if section.settings.layout == 'full-width' %}{{section.settings.layout}}{% else %}container{% endif %}">
    <div class="wrap-section">
      {% if section.settings.title != blank %}
        <div class="wrap_title medium">
          <div class="h2 section-title alo-text-transform" style="--alo-text-transform:uppercase;">
            {{ section.settings.title }}
          </div>
        </div>
      {% endif %}
    </div>

    <div class="products-arrivals">
      <div class="section-content">
        {% if section.blocks.size > 0 %}
          <div class="content_section slick-carousel">
            <div class="grid-slider laber-slick-carousel grid-slider-{{ sid }}"
                 data-wrapper="#shopify-section-{{ sid }}"
                 data-adaptive-height="false"
                 data-autoplay="{% if section.settings.autoplay %}true{% else %}false{% endif %}"
                 data-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
                 data-arrows="{% if section.settings.arrows %}true{% else %}false{% endif %}"
                 data-center-mode="false"
                 data-dots="{% if section.settings.dots %}true{% else %}false{% endif %}"
                 data-fade="false"
                 data-infinite="{% if section.settings.infinite %}true{% else %}false{% endif %}"
                 data-padding="10"
                 data-rows="1"
                 data-slides-to-show="{{ section.settings.slides_to_show }}"
                 data-slides-to-scroll="1"
                 data-speed="{{ section.settings.speed }}"
                 data-vertical="false"
                 data-vertical-swiping="false"
                 data-responsive="[{&quot;breakpoint&quot;:1920,&quot;settings&quot;:{&quot;slidesToShow&quot;:{{ section.settings.slides_to_show }}}},{&quot;breakpoint&quot;:992,&quot;settings&quot;:{&quot;slidesToShow&quot;:{{ section.settings.slides_to_show_tablet }}}},{&quot;breakpoint&quot;:576,&quot;settings&quot;:{&quot;slidesToShow&quot;:{{ section.settings.slides_to_show_mobile }}}}]"
                 data-append-arrows=".arrows_{{ sid }}"
                 data-append-dots=".dots_{{ sid }}">
              
              {% for block in section.blocks %}
                <div class="cat_space_item brand_list alo-item">
                  <div class="alo-image overflow-hidden alo-border-radius ratio w-full" style="--ratio-percent: 40%;">
                    {% if block.settings.link != blank %}
                      <a href="{{ block.settings.link }}" target="_blank">
                        <img src="{{ block.settings.image | image_url }}" alt="Brand Logo" loading="lazy">
                      </a>
                    {% else %}
                      <img src="{{ block.settings.image | image_url }}" alt="Brand Logo" loading="lazy">
                    {% endif %}
                  </div>
                </div>
              {% endfor %}
            </div>

            {% if section.settings.dots %}
              <div class="dots_{{ sid }}"></div>
            {% endif %}
            {% if section.settings.arrows %}
              <div class="arrows_{{ sid }}"></div>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<style>
  #laber_se_{{ sid }} {
    padding: {{ section.settings.padding }};
    background-color: {{ section.settings.bg_color }};
  }
  @media only screen and (max-width: 1024px) {
    #laber_se_{{ sid }} {
      padding: {{ section.settings.padding_mb }};
    }
  }
</style>

{% schema %}
{
  "name": "Brand Logo Slider",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Making Headlines"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "container", "label": "Container" },
        { "value": "full-width", "label": "Full Width" }
      ],
      "default": "container"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "padding",
      "label": "Padding (Desktop)",
      "default": "20px 0 20px 0"
    },
    {
      "type": "text",
      "id": "padding_mb",
      "label": "Padding (Mobile)",
      "default": "10px 0 10px 0"
    },
    {
      "type": "header",
      "content": "Slider Settings"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Autoplay Speed",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "arrows",
      "label": "Show Arrows",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "dots",
      "label": "Show Dots",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "infinite",
      "label": "Infinite Loop",
      "default": false
    },
    {
      "type": "range",
      "id": "speed",
      "min": 300,
      "max": 1000,
      "step": 100,
      "unit": "ms",
      "label": "Transition Speed",
      "default": 300
    },
    {
      "type": "range",
      "id": "slides_to_show",
      "min": 1,
      "max": 10,
      "step": 1,
      "label": "Slides to Show (Desktop)",
      "default": 5
    },
    {
      "type": "range",
      "id": "slides_to_show_tablet",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Slides to Show (Tablet)",
      "default": 3
    },
    {
      "type": "range",
      "id": "slides_to_show_mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Slides to Show (Mobile)",
      "default": 2
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Brand Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand Logo Slider",
      "category": "Image",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
