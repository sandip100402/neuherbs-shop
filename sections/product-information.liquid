                <span class="share-text">Share</span>
                </a>
              </div>
            </div>

            <!-- Popup -->
            <div class="share-overlay" id="shareOverlay">
              <div class="share-popup">
                <span class="close-btn" id="closeSharePopup">&times;</span>
                <h3>Copy Link</h3>
                <input type="text" id="copyLink" readonly value="{{ shop.url }}{{ product.url }}">
                  <span class="share-copy-btn" id="copyButton"><svg class="icon icon-clipboard" width="11" height="13" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                      <path fill-rule="evenodd" clip-rule="evenodd" d="M2 1a1 1 0 011-1h7a1 1 0 011 1v9a1 1 0 01-1 1V1H2zM1 2a1 1 0 00-1 1v9a1 1 0 001 1h7a1 1 0 001-1V3a1 1 0 00-1-1H1zm0 10V3h7v9H1z" fill="currentColor"></path>
                    </svg>
                  </span>

                <ul class="share-icons">
                  <li><a href="https://www.facebook.com/neuherbs" target="_blank"><img src="https://cdn.shopify.com/s/files/1/0764/3185/1753/files/Facebook.png?v=1757005995" width="" height="" alt="Facebook"></a></li>
                  <li><a href="https://x.com/neuherbs_Ind" target="_blank"><img src="https://cdn.shopify.com/s/files/1/0764/3185/1753/files/Twitter.webp?v=1757006124" width="" height="" alt="Twitter"></a></li>
                  <li><a href="https://www.youtube.com/@neuherbs_India/videos" target="_blank"><img src="https://cdn.shopify.com/s/files/1/0764/3185/1753/files/Youtube.png?v=1757006063" width="" height="" alt="YouTube"></a></li>
