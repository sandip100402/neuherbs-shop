{% include 'product-res-variables' %}
{% assign id = section.id  %}
{% assign layout = section.settings.layout %}
{%- assign show_size_guide = settings.product_info_show_size_guide -%}
{%- assign show_delivery = settings.product_info_show_delivery_return -%}
{%- assign show_options = 1 -%}
{%- assign product_page_design = settings.product_page_design -%}
{%- assign nb_thumb = settings.nb_thumb -%}
{%- assign width_zoom = settings.width_zoom -%}
{%- assign height_zoom = settings.height_zoom -%}
{% assign build_variant = "all" %}

{%- assign bg_product_page = settings.bg_product_page -%}
{%- assign pad_top_product_page = settings.pad_top_product_page -%}
{%- assign pad_bottom_product_page = settings.pad_bottom_product_page -%}
<section id="laber_{{id}}">
<div itemscope itemtype="http://schema.org/Product">
  <meta itemprop="name" content="{{ product.title }}">
  <meta itemprop="url" content="{{ shop.url }}{{ product.url }}">
  <meta itemprop="image" content="{{ product.featured_image.src | img_url: 'grande' }}">
<div class="main-content shop-page main-content-detail" 
     style="background-color:{{bg_product_page}};
            padding-top:{{pad_top_product_page}}px;
            padding-bottom:{{pad_bottom_product_page}}px;">
  <div class="container {%if layout != 'full-width' %} {%else%} {{layout}}{%endif%}"> 
    
      <div class="content-offset {{ product_page_design }}">
        <div class="js_product_single row" id="product-single" data-js-product >
          <script class="data-json-product" type="application/json">{% render 'product-get-attributes', product:product, build_variant: 'json' %}</script> 
          <div id="js-stickySidebar" class="details-thumb col-xs-12 col-sm-12 col-md-6 col-lg-6 ">
           <div class="js-sticky-sidebar" >
              {% if product.images.size > 0 %}
                <div class="cms-wrap-main-slider">
                  <div class="wrap-main-slider">
                    <div data-slide-main 
                      data-width-zoom="{{width_zoom}}"
                      data-height-zoom="{{height_zoom}}"
                      data-responsive='[{"breakpoint": 991, "settings": {"dots": true, "arrows": false}}]'
                      class="slider-fors"
                    >                      
                      {% for image in product.images %}                       
                        <div id="main_img_{{image.id }}" data-image-id="{{ image.id }}"  class="full-item">
                          {%- assign image = image.src -%}
                          {%- if image -%}
                          		<img {% if settings.product_info_enable_zoom %} data-style-zoom ="{{settings.type_zoom}}" class="main-image js-image-{{image.id }}" data-zoom-image="{{ image | img_url: '1920x' }}" {% endif %} src="{{ image | img_url: 'grande' }}" style="width:100%; height:auto"alt=""/>
                          {%- endif -%}
                        </div> 
                      {% endfor %}
                    </div>
                    <div class="main_appendArrows"></div>
                    <div class="zoomContainerAppendTo"></div>
                    {% if settings.product_info_show_btn_fullscreen %}
                    <div data-js-gallery class="open_gallery">
                      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M0.000357628 13.3636L0.000596046 10.1813C0.000596046 9.82984 0.28544 9.54512 0.636787 9.54512C0.988253 9.54512 1.27286 9.82984 1.27286 10.1814V11.8261L4.96974 8.12603C5.09417 8.00148 5.25721 7.93963 5.42013 7.93963C5.58281 7.93963 5.7455 8.0016 5.8698 8.12591C6.1183 8.37416 6.11853 8.77699 5.87016 9.02549L2.17208 12.7271H3.81643C4.16789 12.7271 4.45274 13.0121 4.45274 13.3637C4.45274 13.715 4.16777 14 3.81643 14H0.636787C0.467907 14 0.306178 13.9329 0.186758 13.8134C0.067338 13.6941 0.000357628 13.532 0.000357628 13.3636ZM0.636668 4.45524C0.988253 4.45524 1.27286 4.16992 1.27286 3.81869V2.17399L4.90777 5.77791C5.1565 6.02641 5.57638 6.02665 5.82487 5.77815C6.07348 5.53002 6.08206 5.12694 5.83381 4.87857L2.23561 1.27286H3.88174H3.88305C4.23452 1.27286 4.51972 0.988133 4.51984 0.636548C4.51995 0.285439 4.23559 0.000356674 3.884 0.000356674L0.70484 0C0.53584 0 0.339906 0.0670996 0.220843 0.186399C0.101542 0.3057 0.000238419 0.467548 0.000238419 0.636189V3.81881C0.000357628 4.17004 0.285321 4.45524 0.636668 4.45524ZM9.09271 5.80592L12.7273 2.17375V3.81881C12.7273 4.17028 13.0065 4.45452 13.3579 4.45452H13.3552C13.7067 4.45452 13.9902 4.16992 13.9902 3.81881L13.99 0.636667C13.99 0.467787 13.9227 0.305939 13.8034 0.186638C13.6838 0.0672178 13.5217 0.000237465 13.353 0.000237465H10.1732C9.82174 0.000237465 9.5369 0.285201 9.5369 0.636548C9.5369 0.988253 9.82186 1.2731 10.1732 1.2731H11.8171L8.18705 4.90646C7.93832 5.15483 7.94153 5.55826 8.19003 5.8064C8.43852 6.05453 8.84409 6.0543 9.09271 5.80592ZM11.8283 12.6698H10.1842C9.8327 12.6698 9.54798 12.9544 9.54798 13.3058C9.54798 13.6574 9.83282 13.9423 10.1842 13.9423L13.3636 13.9426H13.3637C13.5326 13.9426 13.6942 13.8758 13.8137 13.7565C13.9329 13.6372 14 13.4755 14 13.3064L13.9996 10.124C13.9996 9.77299 13.7148 9.48767 13.3635 9.48767C13.012 9.48767 12.7273 9.77299 12.7273 10.124V11.7689L9.05934 8.09802C8.93503 7.97359 8.77199 7.91138 8.60907 7.91138C8.4465 7.91138 8.28358 7.97335 8.1594 8.09766C7.91079 8.34592 7.91043 8.74911 8.15904 8.99784L11.8283 12.6698Z" fill="#212529"></path>
              </svg>
                      {{'products.product.zoom' | t}}
                    </div>
                    {% endif %}
                  </div>
                </div>
                <div data-fotorama data-allow-full-screen="native" style="width:1px;height:1px;">
                  {% for image in product.images %}                       
                    {%- assign image = image.src -%}
              		{%- if image -%}<img class="lazyload" data-image-id="{{image.id}}" data-src="{{ image | img_url: '1920x' }}" style="width:auto; height:auto" alt=""/>{%- endif -%}                    
                  {% endfor %}
                </div>
                <div data-slide-nav class="slider-nav row" data-slidesToShow ="{{nb_thumb}}"  data-vertical ="{%- if product_page_design =='thumb_left' or product_page_design =='thumb_right' -%}true{%-else-%}false{%- endif -%}">                      
                  {% for image in product.images %}                       
                  <div id="thumb_img_{{image.id }}" data-thumb-id="{{ image.id }}" data-image="{{ image.src | img_url: 'grande' }}" data-z-image="{{ image.src | img_url: '1920x' }}" class="thumb_img">
                    {%- assign image = image.src -%}
                    {%- if image -%}<div class="lazyload pr_lazy_img" data-bgset="{{ image | img_url: '1x1' }}" data-ratio="{{image.aspect_ratio}}" data-sizes="auto" style="padding-top:{{ 1 | divided_by: image.aspect_ratio | times: 100}}%;"></div>{%- endif -%}
                  </div> 
                  {% endfor %}
                </div>
            	
				
            {% else %}
                <div data-slide-main class="slider-fors" >
                  <div data-image-id="{{ product.images[0].id }}" class="thumb_img">                      
                      {%- assign image = product.images[0].src -%}
                      {%- if image -%}<div class="lazyload pr_lazy_img" data-bgset="{{ image | img_url: '1x1' }}" data-ratio="{{image.aspect_ratio}}" data-sizes="auto" style="padding-top:{{ 1 | divided_by: image.aspect_ratio | times: 75}}%;"></div>{%- endif -%}
                  </div>                      
                </div>
            {% endif %}
            </div>
          </div>
<div class="details-info col-xs-12 col-sm-12 col-md-6 col-lg-6">
  <!-- sections/product-information.liquid -->
  <div itemprop="offers" itemscope itemtype="http://schema.org/Offer">
    <meta itemprop="url" content="{{ url }}">
    <meta itemprop="sku" content="{{ sku }}">
    <meta itemprop="priceCurrency" content="{{ shop.currency }}">
    <meta itemprop="price" content="{{ current_variant.price | divided_by: 100.00 }}">
    <link itemprop="availability" href="http://schema.org/{% if current_variant.available %}InStock{% else %}OutOfStock{% endif %}">

               

{% form 'product', product, class: productClasses %}
	{{ form | payment_terms }}
<input type="hidden" name="variant_id" value="{{ current_variant.id }}" data-js-product-variant-input>
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      
      
      {%- when '@app' -%}
        {% render block %}
			{%- when 'name_category' -%}
				
				<div class="name_category">
                  <p data-js-product-collection>
                  <label class="label">{{ 'products.product.Categories' | t }}:</label>
                  {%- if product.collections.size > 0 -%}
                      {% render 'product-get-collections' with product: product %}
                  {%- endif -%} 
                  </p>  
				</div>
			{%- when 'name_product' -%}				
                <h1 class="product-name">
                    <a href="{{ product.url }}"  >{{ product.title }}</a>  
                  	
                </h1>
				{% style%}
					.details-info .product-name{
						text-transform:{{block.settings.np_text_transform}};
						margin-top:{{block.settings.np_mg_top}}px;
                        margin-bottom:{{block.settings.np_mg_bottom}}px;
                        font-size: {{block.settings.np_size}}px;
    					font-weight:{{block.settings.np_weight}};
					}
					 @media (max-width: 767px) {
                      .details-info .product-name{
                          font-size: {{block.settings.np_size_mobile}}px
                      }
					}
				{% endstyle%}
        {%- when 'policy_block' -%}
          {% if product.metafields.custom.policy_icon_text != blank %}
          <div class="policy-icons-block">
              <div class="policy-icons-wrapper">
                {% for block in product.metafields.custom.policy_icon_text.value %}
                  <div class="policy-icon-item">
                    {% if block.icon != blank %}
                      <img 
                        src="{{ block.icon | image_url: width: 50 }}" 
                        alt="{{ block.title }}" 
                        class="icon-img"
                      >
                    {% endif %}
                    
                    {% if block.title != blank %}
                      <p class="policy-icons-text">{{ block.title }}</p>
                    {% endif %}
                  </div>
                {% endfor %}
              </div>
            </div>
          {% endif %}

        {%- when 'short_title_and_share' -%}
          {% if product.metafields.custom.short_title %}
            <div class="pitem-box">
              <!-- Short Title -->
              <div class="short_title">
                {% if product.metafields.custom.short_title %}
                  <span class="text21">{{ product.metafields.custom.short_title }}</span>
                {% endif %}
              </div>

              <!-- Share button -->
              <div class="pitem-social">
                <a id="openSharePopup" href="javascript:void(0)">
                
