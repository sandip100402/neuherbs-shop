{% comment %}
  Section: Collection Category Blocks with Image, Text, and Link (Responsive font)
{% endcomment %}

<style>
.category-blocks-section {
    display: flex;
    gap: 100px;
    justify-content: space-around;
    padding: 20px 0;
}

.category-block {
  position: relative;
  text-align: left; /* align text to left */
  flex: 1;
  border-radius: 30px;
  overflow: hidden;
}

.category-block img {
  width: 100%;
  display: block;
}

.category-block-text {
    position: absolute;
    bottom: 0;
    left: 13px;
    color: #fff;
    font-family: "Museo 700", sans-serif;
    font-weight: 700;
    line-height: 1.2;
    font-size: clamp(16px, 2vw, 32px); /* responsive font: min 16px, max 32px */
}

/* Optional: adjust gap for smaller screens */
@media screen and (max-width: 768px) {
  .category-blocks-section {
    gap: 20px;
    padding: 15px 10px;
  }
}
</style>

<section class="category-blocks-section container">
  {% for block in section.blocks %}
    <div class="category-block">
      <a href="{{ block.settings.link }}">
        <img src="{{ block.settings.image | image_url }}" alt="{{ block.settings.text }}">
        <div class="category-block-text">
          {{ block.settings.text }}
        </div>
      </a>
    </div>
  {% endfor %}
</section>

{% schema %}
{
  "name": "Category Blocks",
  "tag": "section",
  "settings": [],
  "blocks": [
    {
      "type": "category_block",
      "name": "Category Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Collection Category Blocks"
    }
  ]
}
{% endschema %}
